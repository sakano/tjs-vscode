{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "watch:bundle",
            "problemMatcher": "$esbuild-watch",
            "isBackground": true,
            "presentation": {
                "group": "watch",
                "panel": "dedicated",
                "reveal": "never"
            }
        },
        {
            "type": "npm",
            "script": "watch:types",
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "presentation": {
                "group": "watch",
                "panel": "dedicated",
                "reveal": "never"
            }
        },
        {
            "label": "watch",
            "dependsOn": [
                "npm: watch:bundle",
                "npm: watch:types"

{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "types": [
            "mocha",
            "node"
        ],
        "noEmit": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noUncheckedSideEffectImports": true
    },
    "include": [
        ".vscode-test.mjs",
        "esbuild.mjs",
        "eslint.config.mjs",
        "scripts/**/*.mjs"
    ],
    "exclude": [
        "node_modules",
        ".vscode-test",
        ".vscode-test-web"
    ]
}

{
    "name": "tjs-vscode",
    "displayName": "TJS",
    "description": "%tjs.description%",
    "version": "1.2.1",
    "publisher": "Biscrat",
    "license": "MIT",
    "icon": "images/tjsicon.png",
    "files": [
        "dist/extension.js",
        "dist/web/extension.js",
        "images/tjsicon.png",
        "language-configuration.json",
        "syntaxes/tjs.tmLanguage.json",
        "snippets/tjs.json",
        "package.nls.json",
        "package.nls.ja.json",
        "README.md",
        "README-ja.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "engines": {
        "node": "24.x",
        "vscode": "^1.125.0"
    },
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "%tjs.untrustedWorkspaces.description%",
            "restrictedConfigurations": [
                "tjs.ctagsProcess"
            ]
        },
        "virtualWorkspaces": {
            "supported": "limited",
            "description": "%tjs.virtualWorkspaces.description%"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/sakano/tjs-vscode.git"
    },
    "bugs": {
        "url": "https://github.com/sakano/tjs-vscode/issues"
    },
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "keywords": [
        "kirikiri"
    ],
    "contributes": {
        "languages": [
            {
                "id": "tjs",
                "aliases": [
                    "TJS",
                    "tjs"
                ],
                "extensions": [
                    ".tjs"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "tjs",
                "scopeName": "source.tjs",
                "path": "./syntaxes/tjs.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "tjs",
                "path": "./snippets/tjs.json"
            }
        ],
        "commands": [
            {
                "command": "tjs.updateCtags",
                "title": "%tjs.updateCtags.title%",
                "category": "TJS",
                "enablement": "isWorkspaceTrusted && !virtualWorkspace && shellExecutionSupported && workspaceFolderCount > 0"
            },
            {
                "command": "tjs.openReferencePallet",
                "title": "%tjs.openReferencePallet.title%",
                "category": "TJS"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "tjs.updateCtags",
                    "when": "!virtualWorkspace && shellExecutionSupported && workspaceFolderCount > 0"
                }
            ]
        },
        "keybindings": [
            {
                "command": "tjs.openReferencePallet",
                "key": "ctrl+shift+alt+r",
                "when": "editorLangId == tjs"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "%tjs.configuration.title%",
            "properties": {
                "tjs.ctagsProcess": {
                    "description": "%tjs.ctagsProcess.description%",
                    "type": "array",
                    "scope": "resource",
                    "default": [
                        {
                            "tagFilePath": ".tags",
                            "searchPath": "",
                            "searchRecursive": true,
                            "runOnSave": false,
                            "fileExtensions": [
                                ".tjs"
                            ],
                            "extraArgs": [],
                            "timeoutMs": 120000
                        }
                    ],
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "tagFilePath": {
                                "description": "%tjs.items.tagFilePath.description%",
                                "type": "string",
                                "minLength": 1,
                                "default": ".tags"
                            },
                            "searchPath": {
                                "description": "%tjs.items.searchPath.description%",
                                "type": "string",
                                "default": ""
                            },
                            "searchRecursive": {
                                "description": "%tjs.items.searchRecursive.description%",
                                "type": "boolean",
                                "default": true
                            },
                            "runOnSave": {
                                "description": "%tjs.items.runOnSave.description%",
                                "type": "boolean",
                                "default": false
                            },
                            "fileExtensions": {
                                "description": "%tjs.items.fileExtensions.description%",
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "default": [
                                    ".tjs"
                                ]
                            },
                            "extraOption": {
                                "description": "%tjs.items.extraOption.description%",
                                "type": "string",
                                "markdownDeprecationMessage": "%tjs.items.extraOption.deprecationMessage%"
                            },
                            "extraArgs": {
                                "description": "%tjs.items.extraArgs.description%",
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "default": []
                            },
                            "timeoutMs": {
                                "description": "%tjs.items.timeoutMs.description%",
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 2147483647,
                                "default": 120000
                            }
                        }
                    }
                },
                "tjs.ctagsRunOnSaveLanguages": {
                    "description": "%tjs.ctagsRunOnSaveLanguages.description%",
                    "type": "array",
                    "scope": "resource",
                    "default": [
                        "tjs"
                    ],
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "tjs.referencePalletEnable": {
                    "description": "%tjs.referencePalletEnable.description%",
                    "type": "object",
                    "scope": "window",
                    "additionalProperties": false,
                    "default": {
                        "tjs": true,
                        "krkrZ": true,
                        "krkr2": false,
                        "dll": false
                    },
                    "properties": {
                        "tjs": {
                            "description": "%tjs.referencePalletEnable.tjs.description%",
                            "type": "boolean",
                            "default": true
                        },
                        "krkrZ": {
                            "description": "%tjs.referencePalletEnable.krkrZ.description%",
                            "type": "boolean",
                            "default": true
                        },
                        "krkr2": {
                            "description": "%tjs.referencePalletEnable.krkr2.description%",
                            "type": "boolean",
                            "default": false
                        },
                        "dll": {
                            "description": "%tjs.referencePalletEnable.dll.description%",
                            "type": "boolean",
                            "default": false
                        }
                    }
                }
            }
        }
    },
    "scripts": {
        "clean": "node ./scripts/clean.mjs",
        "check-types": "tsc --noEmit -p ./",
        "bundle": "node ./esbuild.mjs",
        "bundle:production": "node ./esbuild.mjs --production",
        "compile": "npm run check-types && npm run bundle",
        "compile-tests": "tsc -p ./ --outDir out",
        "watch:bundle": "node ./esbuild.mjs --watch",
        "watch:types": "tsc --noEmit --watch -p ./",
        "package": "npm run clean && npm run check-types && npm run bundle:production",
        "vscode:prepublish": "npm run package",
        "pretest": "npm run clean && npm run bundle && npm run compile-tests",
        "test": "npm run test:desktop && npm run test:web",
        "test:desktop": "vscode-test && node ./scripts/run-untrusted-tests.mjs",
        "test:web": "vscode-test-web --browserType=chromium --quality=stable --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/index.js src/test/fixtures/trusted-workspace",
        "vsix": "vsce package"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "@types/vscode": "1.125.0",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/test-web": "^0.0.81",
        "@vscode/vsce": "3.9.2",
        "esbuild": "0.28.1",
        "eslint": "^10.8.1",
        "mocha": "^11.8.0",
        "typescript": "^6.0.3"
    },
    "overrides": {
        "mocha": {
            "diff": "^8.0.3",
            "serialize-javascript": "^7.1.0"
        }
    },
    "allowScripts": {
        "@playwright/browser-chromium@1.62.1": true,
        "@vscode/vsce-sign@2.0.9": true,
        "esbuild@0.28.1": true,
        "fsevents@2.3.2": false,
        "keytar": false
    },
    "vsce": {
        "dependencies": false,
        "githubBranch": "master"
    },
    "main": "./dist/extension.js",
    "browser": "./dist/web/extension.js"
}

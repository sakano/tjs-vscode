{
    "name": "tjs-vscode",
    "displayName": "TJS",
    "description": "%tjs.description%",
    "version": "1.2.1",
    "publisher": "Biscrat",
    "license": "MIT",
    "icon": "images/tjsicon.png",
    "engines": {
        "node": "24.x",
        "vscode": "^1.125.0"
    },
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "%tjs.untrustedWorkspaces.description%",
            "restrictedConfigurations": [
                "tjs.ctagsProcess"
            ]
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/sakano/tjs-vscode.git"
    },
    "bugs": {
        "url": "https://github.com/sakano/tjs-vscode/issues"
    },
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "keywords": [
        "kirikiri"
    ],
    "contributes": {
        "languages": [
            {
                "id": "tjs",
                "aliases": [
                    "TJS",
                    "tjs"
                ],
                "extensions": [
                    ".tjs"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "tjs",
                "scopeName": "source.tjs",
                "path": "./syntaxes/tjs.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "tjs",
                "path": "./snippets/tjs.json"
            }
        ],
        "commands": [
            {
                "command": "tjs.updateCtags",
                "title": "%tjs.updateCtags.title%",
                "category": "TJS",
                "enablement": "isWorkspaceTrusted"
            },
            {
                "command": "tjs.openReferencePallet",
                "title": "%tjs.openReferencePallet.title%",
                "category": "TJS"
            }
        ],
        "keybindings": [
            {
                "command": "tjs.openReferencePallet",
                "key": "ctrl+shift+alt+r",
                "when": "editorLangId == tjs"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "%tjs.configuration.title%",
            "properties": {
                "tjs.ctagsProcess": {
                    "description": "%tjs.ctagsProcess.description%",
                    "type": "array",
                    "scope": "resource",
                    "default": [
                        {
                            "tagFilePath": ".tags",
                            "searchPath": "",
                            "searchRecursive": true,
                            "runOnSave": false,
                            "fileExtensions": [
                                ".tjs"
                            ],
                            "extraArgs": [],
                            "timeoutMs": 120000
                        }
                    ],
                    "items": {
                        "type": "object",
                        "properties": {
                            "tagFilePath": {
                                "description": "%tjs.items.tagFilePath.description%",
                                "type": "string",
                                "default": ".tags"
                            },
                            "searchPath": {
                                "description": "%tjs.items.searchPath.description%",
                                "type": "string",
                                "default": ""
                            },
                            "searchRecursive": {
                                "description": "%tjs.items.searchRecursive.description%",
                                "type": "boolean"
                            },
                            "runOnSave": {
                                "description": "%tjs.items.runOnSave.description%",
                                "type": "boolean"
                            },
                            "fileExtensions": {
                                "description": "%tjs.items.fileExtensions.description%",
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "default": [
                                    ".tjs"
                                ]
                            },
                            "extraOption": {
                                "description": "%tjs.items.extraOption.description%",
                                "type": "string",
                                "markdownDeprecationMessage": "%tjs.items.extraOption.deprecationMessage%"
                            },
                            "extraArgs": {
                                "description": "%tjs.items.extraArgs.description%",
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "default": []
                            },
                            "timeoutMs": {
                                "description": "%tjs.items.timeoutMs.description%",
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 2147483647,
                                "default": 120000
                            }
                        }
                    }
                },
                "tjs.ctagsRunOnSaveLanguages": {
                    "description": "%tjs.ctagsRunOnSaveLanguages.description%",
                    "type": "array",
                    "scope": "resource",
                    "default": [
                        "tjs"
                    ],
                    "items": {
                        "type": "string"
                    }
                },
                "tjs.referencePalletEnable": {
                    "description": "%tjs.referencePalletEnable.description%",
                    "type": "object",
                    "default": {
                        "tjs": true,
                        "krkrz": true,
                        "krkr2": false,
                        "dll": false
                    },
                    "properties": {
                        "tjs": {
                            "description": "%tjs.referencePalletEnable.tjs.description%",
                            "type": "boolean"
                        },
                        "krkrZ": {
                            "description": "%tjs.referencePalletEnable.krkrZ.description%",
                            "type": "boolean"
                        },
                        "krkr2": {
                            "description": "%tjs.referencePalletEnable.krkr2.description%",
                            "type": "boolean"
                        },
                        "dll": {
                            "description": "%tjs.referencePalletEnable.dll.description%",
                            "type": "boolean"
                        }
                    }
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "test": "vscode-test && node ./scripts/run-untrusted-tests.mjs"
    },
    "devDependencies": {
        "@types/vscode": "1.125.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "eslint": "^10.8.1",
        "typescript": "^6.0.3"
    },
    "overrides": {
        "mocha": {
            "diff": "^8.0.3",
            "serialize-javascript": "^7.1.0"
        }
    },
    "main": "./out/extension"
}
